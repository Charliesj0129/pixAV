server {
    listen 8080;
    access_log off;
    location = /health { return 200 'ok'; }
    location /stream/ {
        proxy_pass http://strm_resolver:8000;
        proxy_set_header Authorization "Bearer ${PIXAV_RESOLVER_BEARER}";
        proxy_set_header Host strm_resolver;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_connect_timeout 10s;
    }
    location / { return 404; }
}
