# pixAV environment variables
# Copy to .env and adjust for your setup

# PostgreSQL
PIXAV_DB_HOST=localhost
PIXAV_DB_PORT=5432
PIXAV_DB_USER=pixav
PIXAV_DB_PASSWORD=pixav
PIXAV_DB_NAME=pixav
PIXAV_POSTGRES_PORT=5432

# Managed media is opt-in after migration/identity/ownership acceptance.
# Provision separate non-superuser logins; never grant the authority role to a
# legacy worker. Keep login passwords in private .env, never in migration SQL.
PIXAV_MANAGED_MEDIA_WORKFLOW=false
PIXAV_SOURCE_MIN_QUALITY_SCORE=0
# PIXAV_MAXWELL_DB_USER=<member of pixav_execution_authority>
# PIXAV_MAXWELL_DB_PASSWORD=<private credential>
# PIXAV_ACTIVITY_DB_USER=<member of pixav_activity_worker only>
# PIXAV_ACTIVITY_DB_PASSWORD=<private credential>
# The stream endpoint only reads eligibility and records cache demand.
# PIXAV_RESOLVER_DB_USER=<member of pixav_playback_reader only>
# PIXAV_RESOLVER_DB_PASSWORD=<private credential>

# Redis
PIXAV_REDIS_URL=redis://localhost:6379/0
PIXAV_REDIS_PORT=6379
PIXAV_SYSTEM_PAUSE_KEY=system:pause
PIXAV_DOWNLOAD_PAUSE_KEY=pixav:download:pause

# qBittorrent
PIXAV_QBIT_PORT=8085
PIXAV_QBIT_URL=http://localhost:8085
PIXAV_QBIT_USER=admin
PIXAV_QBIT_PASSWORD=adminadmin
# qBittorrent-container path. PIXAV_DOWNLOAD_DIR below is the corresponding
# pixAV worker path; QBitClient maps between them with containment checks.
PIXAV_QBIT_DOWNLOAD_DIR=/downloads
# Operator-maintained trackers for bare magnets. Comma or newline separated.
# Not optional in practice: every Sehuatang magnet arrives without "&tr=", and a
# client with no tracker has only DHT, which is slower than the no-peer grace
# period. Leaving this empty gets live swarms classified as dead. Measure a
# tracker before adding it; several well-known ones do not resolve or answer.
PIXAV_QBIT_EXTRA_TRACKERS=
# Overall budget for one torrent download.
PIXAV_QBIT_DOWNLOAD_TIMEOUT_SECONDS=3600
# How long a torrent may show no swarm at all (no tracker-known seeds, no
# availability) before its source candidate is declared unavailable. Kept far
# below the download timeout so a dead magnet frees its task in minutes.
PIXAV_QBIT_NO_PEER_GRACE_SECONDS=300
# How long a failed source candidate is parked before it is retried. A dead
# swarm today may be alive next week, so candidates cool down, never delete.
PIXAV_SOURCE_CANDIDATE_COOLDOWN_HOURS=6

# VPN (gluetun): required only for --mode vpn (base + prod).
# --mode direct adds docker-compose.direct.yml, disables the sentinel and
# loader VPN egress monitor, and requires no VPN credentials.
# VPN mode remains gated by gluetun health; never substitute direct implicitly.
PIXAV_VPN_SERVICE_PROVIDER=
PIXAV_VPN_TYPE=wireguard
# WireGuard (preferred)
PIXAV_WIREGUARD_PRIVATE_KEY=
PIXAV_WIREGUARD_ADDRESSES=
# OpenVPN (only if the provider has no WireGuard support)
PIXAV_OPENVPN_USER=
PIXAV_OPENVPN_PASSWORD=
# Optional server selection, e.g. Netherlands,Switzerland
PIXAV_VPN_SERVER_COUNTRIES=
# ProtonVPN only: restrict selection to its P2P-capable server pool.
PIXAV_VPN_PORT_FORWARD_ONLY=off
# Subnets allowed to bypass the kill switch so the Docker network can reach the
# WebUI. Must cover the pixav bridge subnet; widen it only if that subnet differs.
PIXAV_VPN_LAN_SUBNETS=172.16.0.0/12
# Egress leak detection. Secondary to the kill switch and never a gate on
# downloading: it reports pixav_vpn_egress_state, it does not pause anything.
# Both observers must call the SAME endpoint or they can disagree merely by
# answering in different address families. Empty disables the check.
PIXAV_VPN_EGRESS_ECHO_URL=https://api.ipify.org
PIXAV_VPN_EGRESS_INTERVAL_SECONDS=300

# Media-Loader
# full: real download + remux
# verify: qBit connectivity + placeholder file + route-to-upload
PIXAV_MEDIA_LOADER_MODE=full
PIXAV_DOWNLOAD_DIR=./data/downloads
PIXAV_REMUX_DIR=./data/remuxed
PIXAV_MEDIA_SEGMENT_TARGET_BYTES=9500000000
PIXAV_DOWNLOAD_MIN_FREE_BYTES=107374182400
PIXAV_DOWNLOAD_MIN_FREE_PERCENT=10
# Required for managed Windows disk latches; file contents never enter env/argv.
# PIXAV_DOWNLOAD_PAUSE_TOKEN_FILE=/run/secrets/download_pause_token
PIXAV_LOCAL_CLEANUP_SUCCESS_HOURS=24
PIXAV_LOCAL_CLEANUP_FAILURE_DAYS=7
PIXAV_LOCAL_CLEANUP_BATCH_SIZE=100
# Staging deletion stays off until every durability gate is provably met.
# With it off the janitor still evaluates and audits each artifact.
PIXAV_LOCAL_CLEANUP_APPLY=false

# How long a DURABLE remote asset may go without an independent cold re-read
# before the authority opens a verify-only execution for it. A copy nobody ever
# looks at again is an assumption, not a fact. 0 disables re-verification.
PIXAV_REMOTE_REVERIFY_INTERVAL_DAYS=30

# Optional embeddings (very heavy deps: sentence-transformers/torch)
PIXAV_EMBEDDINGS_ENABLED=0

# Windows Android Emulator + Docker Runner (standalone development entry).
# See README before starting: use the Microsoft WSL kernel, not a redroid kernel.
# These keys configure docker-compose.android-runner.yml only; they do not
# enable Windows Emulator support in the existing managed storage worker.
# Reuse docker/photos-canary.Dockerfile; inspect and supply its immutable image ID.
PIXAV_ANDROID_RUNNER_IMAGE=
PIXAV_ANDROID_ADB_SERVER_HOST=host.docker.internal
# Required: exact serial from the Windows ADB server, e.g. emulator-5554.
PIXAV_ANDROID_SERIAL=
# Required: existing absolute path on the daemon host, containing synthetic media.
# The runner mounts this read-only and refuses to create a missing source path.
PIXAV_ANDROID_RUNNER_STAGING_DIR=

# Legacy Redroid runtime (pending migration; not the Windows development entry).
PIXAV_REDROID_IMAGE=redroid/redroid:14.0.0-latest
PIXAV_REDROID_NETWORK=bridge
PIXAV_REDROID_ADB_HOST=127.0.0.1
PIXAV_REDROID_ADB_PORT_START=5555
PIXAV_EVIDENCE_UID=1000
PIXAV_EVIDENCE_GID=1000
# Device identity profile. The named profile in config/android_profiles.yml
# supplies the image and the ro.* overrides passed to the container, plus the
# readiness evidence proving the identity took effect. PIXAV_REDROID_IMAGE above
# is only the fallback for a manager built without a profile.
PIXAV_REDROID_PROFILE=gphotos_pixel_xl_v1
PIXAV_REDROID_PROFILES_PATH=config/android_profiles.yml

# Pixel-Injector
# windows_android: managed registered Windows runtime, mutual TLS and persistent UI fence.
# redroid: retained legacy adapters only; managed default provisioning is retired.
# local: mark upload complete and emit a synthetic share_url (for local resolver testing)
PIXAV_PIXEL_INJECTOR_MODE=windows_android
# Legacy runtime prerequisites; not instructions to change the Windows WSL kernel.
# docker build -f docker/photos-canary.Dockerfile -t pixav-photos-canary:maestro-2.10.0 .
# Verify config/android_profiles.yml image exists; never replace it silently.
# Managed storage activities: Maestro flows, and the cold read-back root that
# must never be shared with staging or upload temporaries.
PIXAV_STORAGE_FLOWS_DIR=config/maestro/photos-canary
PIXAV_STORAGE_READBACK_DIR=./data/storage-readback
PIXAV_STORAGE_STAGING_DIR=./data/storage-staging
PIXAV_STORAGE_GUEST_DATA_DIR=./data/storage-guest
# The cold read-back runs in this image and mounts only /work plus a read-only
# source tree, so its receipt cannot be satisfied by a local copy.
# Build: docker build -f docker/storage-tools.Dockerfile -t pixav-storage-tools:1 .
PIXAV_STORAGE_READBACK_IMAGE=pixav-storage-tools:1
# The registered device owner must remain stable across restarts.
# PIXAV_STORAGE_WORKER_OWNER=<stable uuid>
# Registration and external identity changes require an authority-reviewed generation.
# PIXAV_STORAGE_WINDOWS_RUNTIME_ID=<registered runtime uuid>
PIXAV_STORAGE_WINDOWS_RUNTIME_GENERATION=1
PIXAV_STORAGE_WINDOWS_PROFILE=gphotos_pixel_xl_infinity_v1
PIXAV_STORAGE_ANDROID_ADB_SERVER_HOST=host.docker.internal
# File references mount into authority/worker only, never the Android tools runner.
# The server binds Windows loopback and requires a valid client certificate.
# PIXAV_WINDOWS_CONTROL_URL=https://host.docker.internal:5043
# PIXAV_WINDOWS_CONTROL_CA=/run/secrets/windows-control-ca.crt
# PIXAV_WINDOWS_CONTROL_CERTIFICATE=/run/secrets/windows-control-client.crt
# PIXAV_WINDOWS_CONTROL_KEY=/run/secrets/windows-control-client.key
# PIXAV_WINDOWS_CONTROL_DOCKER_DAEMON_ID=<verified Docker daemon id>
# PIXAV_WINDOWS_CONTROL_IDENTITY_SHA256=<enrolled native identity sha256>
# PIXAV_WINDOWS_CAPACITY_VOLUME_DEVICE=<enrolled physical Windows volume device>
PIXAV_STORAGE_WORKER_HEALTH_PORT=8005
# Guest/tools limits apply to journal-owned sibling containers (not just worker).
# CPUs are core equivalents. Memory is MiB; swap is disabled above that limit.
PIXAV_STORAGE_GUEST_CPUS=2.0
PIXAV_STORAGE_GUEST_MEMORY_MB=4096
PIXAV_STORAGE_TOOLS_CPUS=1.0
PIXAV_STORAGE_TOOLS_MEMORY_MB=2048
PIXAV_STORAGE_WORKER_CPUS=1.0
PIXAV_STORAGE_WORKER_MEMORY=1g
# Where this checkout lives on the Docker daemon's host. Leave empty when the
# worker runs on the host; compose sets it because a containerised worker hands
# bind-mount sources to a daemon that resolves them outside the container.
# PIXAV_HOST_PROJECT_ROOT=/absolute/path/to/pixAV
PIXAV_PIXEL_INJECTOR_LOCAL_SHARE_SCHEME=pixav-local://

# Strm-Resolver
PIXAV_RESOLVER_HOST=0.0.0.0
PIXAV_RESOLVER_PORT=8000
# Private playback deployments must enable this and mount a regular 0600 token
# file containing 43-128 URL-safe characters. Never put tokens in STRM URLs.
PIXAV_RESOLVER_AUTH_REQUIRED=false
PIXAV_RESOLVER_TOKEN_FILE=
# docker-compose.playback.yml enables authentication and uses this host file.
PIXAV_RESOLVER_TOKEN_HOST_FILE=./secrets/resolver_token
PIXAV_JELLYFIN_PORT=8096
# Verified playback cache. Disposable: PostgreSQL holds the facts and Photos the
# bytes. Objects unread for the TTL are evicted, sooner past the optional byte
# budget (0 = none); a reader holding an object always delays its eviction.
PIXAV_PLAYBACK_CACHE_DIR=./data/playback-cache
PIXAV_PLAYBACK_CACHE_TTL_HOURS=72
PIXAV_PLAYBACK_CACHE_MAX_BYTES=0
PIXAV_PLAYBACK_CACHE_SWEEP_SECONDS=300
# A cold stream request waits this long for the rebuild, then answers 503 with
# Retry-After while the rebuild continues.
PIXAV_PLAYBACK_COLD_WAIT_SECONDS=60
PIXAV_PLAYBACK_WORKER_HEALTH_PORT=8007

# Library projection. Point the media server at <PIXAV_LIBRARY_ROOT>/library.
# Everything under the library root is derived and rebuilt from PostgreSQL;
# the artwork root holds retained originals and belongs in backups. The .strm
# files contain PIXAV_RESOLVER_BASE_URL, so it must be the address players use.
PIXAV_LIBRARY_ROOT=./data/library
PIXAV_ARTWORK_ROOT=./data/artwork
PIXAV_LIBRARY_RECONCILE_SECONDS=300
PIXAV_RESOLVER_BASE_URL=http://localhost:8000

# Migration DSN (used by scripts/migrate.py)
PIXAV_DSN=postgresql://pixav:pixav@localhost:5432/pixav

# Queue names
PIXAV_QUEUE_CRAWL=pixav:crawl
PIXAV_QUEUE_DOWNLOAD=pixav:download
PIXAV_QUEUE_DOWNLOAD_DLQ=pixav:download:dlq
PIXAV_QUEUE_UPLOAD=pixav:upload
PIXAV_QUEUE_UPLOAD_DLQ=pixav:upload:dlq
PIXAV_QUEUE_VERIFY=pixav:verify

# Retry
PIXAV_DOWNLOAD_MAX_RETRIES=6
PIXAV_UPLOAD_MAX_RETRIES=6
PIXAV_RETRY_BACKOFF_SECONDS=60,300,900,3600,21600,86400
PIXAV_DLQ_RETENTION_DAYS=30
PIXAV_DLQ_MAX_ITEMS_PER_STAGE=1000

# Upload execution controls
PIXAV_UPLOAD_MAX_CONCURRENCY=1
PIXAV_UPLOAD_LOCK_KEY=pixav:upload:lock
PIXAV_UPLOAD_LOCK_TTL_SECONDS=7200
PIXAV_UPLOAD_TASK_TIMEOUT_SECONDS=3600
PIXAV_UPLOAD_READY_TIMEOUT_SECONDS=120
PIXAV_UPLOAD_VERIFY_TIMEOUT_SECONDS=300

# Scheduling policy
PIXAV_NO_ACCOUNT_POLICY=wait

# Crawl seeds (comma-separated)
PIXAV_CRAWL_SEED_URLS=
PIXAV_CRAWL_LINK_FILTER_PATTERN=(viewthread|thread)
PIXAV_CRAWL_QUERIES=
PIXAV_CRAWL_MAX_PAGES=50
PIXAV_CRAWL_INTERVAL_SECONDS=3600
PIXAV_CRAWL_EMPTY_ERROR_THRESHOLD=3
PIXAV_CRAWL_EMPTY_CYCLES_KEY=pixav:crawl:empty_cycles
PIXAV_CRAWL_COOKIE_HEADER=
PIXAV_CRAWL_COOKIE_FILE=

# Optional Phase 0 boundary evidence. Empty disables writes; use a private shared
# cohort/events directory visible at the same path in both workers.
PIXAV_PHASE0_EVENTS_DIR=

# Crawling integrations
PIXAV_FLARESOLVERR_URL=http://localhost:8191
PIXAV_JACKETT_URL=http://localhost:9117
PIXAV_JACKETT_API_KEY=

# Optional Stash enrichment. The Compose service is under the `stash` profile.
PIXAV_STASH_ENABLED=0
PIXAV_STASH_URL=http://localhost:9999

# Event-loop health/watchdog
PIXAV_HEARTBEAT_INTERVAL_SECONDS=5
PIXAV_HEARTBEAT_STALE_SECONDS=120

# Monitoring. These point to Docker secret files; never place values in .env.
PIXAV_PROMETHEUS_PORT=9090
PIXAV_ALERTMANAGER_PORT=9093
PIXAV_TELEGRAM_BOT_TOKEN_FILE=./secrets/telegram_bot_token
PIXAV_TELEGRAM_CHAT_ID_FILE=./secrets/telegram_chat_id

# E2E scripts (optional)
# Legal fixed fixture from WebTorrent/Blender (CC BY 3.0). This forces an
# isolated database, real qBittorrent download, and full stream-copy remux.
PIXAV_E2E_FIXTURE=
# Provide a magnet to avoid live crawling:
PIXAV_E2E_MAGNET_URI=
# Or crawl a seed URL:
PIXAV_E2E_SEED_URL=
PIXAV_E2E_LINK_PATTERN=
PIXAV_E2E_CRAWL_MAX_PAGES=10
# Upload account seeding (scripts/seed_password.py, scripts/test_adb_login.py).
# Never commit real values -- set these in your local .env only.
PIXAV_SEED_ACCOUNT_EMAIL=
PIXAV_SEED_ACCOUNT_PASSWORD=

# Managed download observations are short activities; Maxwell schedules with DB time.
PIXAV_MANAGED_DOWNLOAD_POLL_SECONDS=15
PIXAV_MANAGED_DOWNLOAD_STALL_SECONDS=900

# Phased managed entry: windows-tools and infrastructure-only core profiles.
# Keep the real values in a private 0600 env under a 0700 directory.
PIXAV_MANAGED_PROJECT=pixav-managed-example
PIXAV_MANAGED_WINDOWS_TOOLS_IMAGE=
PIXAV_MANAGED_STAGING_HOST_ROOT=
# Uses PIXAV_ANDROID_SERIAL plus the existing stable PIXAV_STORAGE_WORKER_OWNER,
# PIXAV_STORAGE_WINDOWS_RUNTIME_ID and PIXAV_STORAGE_WINDOWS_RUNTIME_GENERATION.

# core never starts an executor or replays a queue. Existing directories only.
PIXAV_MANAGED_DATA_ROOT=
# Optional prepared PostgreSQL 16 bind root, containing pgdata/PG_VERSION and
# pgdata/global/pg_control. Core preflight also requires --postgres-host-root.
# Redis and all other data roots continue to use PIXAV_MANAGED_DATA_ROOT.
PIXAV_MANAGED_POSTGRES_HOST_ROOT=
PIXAV_MANAGED_SECRETS_ROOT=
# Optional private Redis URL reference; pair with application preflight
# --redis-client-url-secret and the selected PIXAV_EXPECTED_REDIS_DATABASE.
PIXAV_MANAGED_REDIS_CLIENT_URL_FILE=
PIXAV_MANAGED_DB_ADMIN=pixav_admin
PIXAV_MANAGED_DATABASE=pixav_managed
PIXAV_MANAGED_UID=1000
PIXAV_MANAGED_GID=1000

# Managed schema/authority: immutable app/cold images and fresh instance pins.
PIXAV_MANAGED_APP_IMAGE=
PIXAV_MANAGED_COLD_IMAGE=
PIXAV_MANAGED_DOCKER_GID=
PIXAV_EXPECTED_DB_IDENTITY=
PIXAV_EXPECTED_DB_NAME=
PIXAV_EXPECTED_REDIS_RUN_ID=
# Must match the DB selected by the private Redis URL; defaults to 0 in managed Compose.
PIXAV_EXPECTED_REDIS_DATABASE=0
# In containers use /run/secrets; DB password and Redis URL are files named
# PIXAV_DB_PASSWORD and PIXAV_REDIS_URL. No credential values belong here.
PIXAV_SETTINGS_SECRETS_DIR=
